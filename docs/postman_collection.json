            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "{{gameId}}",
                "join"
