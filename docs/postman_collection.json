    },
    {
      "name": "Games",
      "item": [
        {
          "name": "Get Games List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "games"
              ]
            }
          }
        },
        {
          "name": "Get Game By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/games/{{gameId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "games",
                "{{gameId}}"
              ]
            }
          }
        },
        {
          "name": "Create Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('gameId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/games",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "games"
              ]
            }
          }
        },
        {
          "name": "Join Game",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
