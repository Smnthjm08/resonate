{
  "info": {
    "_postman_id": "c1f2e3d4-5678-4901-abcd-ef1234567890",
    "name": "Chess Game API",
    "description": "Postman Collection v2.1 for Chess Game Backend (Express + WebSocket)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001",
      "type": "string"
